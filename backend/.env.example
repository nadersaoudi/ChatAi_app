# Copy to .env and fill in your values.
GROQ_API_KEY=
# Primary chat model (must be accessible for your key). Default works on free keys.
GROQ_MODEL=openai/gpt-oss-20b
# Comma-separated fallbacks tried when the primary model is unavailable.
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,meta-llama/llama-4-scout-17b-16e-instruct,qwen/qwen3-32b,openai/gpt-oss-120b

# Max completion tokens (reasoning models need headroom; 1024 cut long answers).
GROQ_MAX_TOKENS=4096

MONGO_URI=
MONGO_DB_NAME=chatai_app

# Base directory for per-user FAISS indexes (each user gets a subfolder).
# Leave empty to keep the historical faiss_index_<user_id> layout.
FAISS_INDEX_PATH=

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
